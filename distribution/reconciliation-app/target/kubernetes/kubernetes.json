  "apiVersion" : "apps/v1",
  "kind" : "Deployment",
  "metadata" : {
    "annotations" : {
      "app.quarkus.io/quarkus-version" : "3.27.2",
      "app.quarkus.io/vcs-uri" : "https://github.com/gcl858/myhello-platform.git",
      "app.quarkus.io/build-timestamp" : "2026-08-17 - 11:40:51 +0000"
    },
    "labels" : {
      "app.kubernetes.io/name" : "reconciliation-app",
      "app.kubernetes.io/version" : "1.0.0-SNAPSHOT",
      "app.kubernetes.io/managed-by" : "quarkus"
    },
    "name" : "reconciliation-app"
  },
  "spec" : {
    "replicas" : 1,
    "selector" : {
      "matchLabels" : {
        "app.kubernetes.io/version" : "1.0.0-SNAPSHOT",
        "app.kubernetes.io/name" : "reconciliation-app"
      }
    },
    "template" : {
      "metadata" : {
        "annotations" : {
          "app.quarkus.io/quarkus-version" : "3.27.2",
          "app.quarkus.io/vcs-uri" : "https://github.com/gcl858/myhello-platform.git",
          "app.quarkus.io/build-timestamp" : "2026-08-17 - 11:40:51 +0000"
        },
        "labels" : {
          "app.kubernetes.io/managed-by" : "quarkus",
          "app.kubernetes.io/version" : "1.0.0-SNAPSHOT",
          "app.kubernetes.io/name" : "reconciliation-app"
        }
      },
      "spec" : {
        "containers" : [ {
          "env" : [ {
            "name" : "KUBERNETES_NAMESPACE",
            "valueFrom" : {
              "fieldRef" : {
                "fieldPath" : "metadata.namespace"
              }
            }
          }, {
            "name" : "QUARKUS_FLYWAY_ACTIVE",
            "value" : "false"
          } ],
          "image" : "docker.io/op/reconciliation-app:1.0.0-SNAPSHOT",
          "imagePullPolicy" : "Always",
          "livenessProbe" : {
            "failureThreshold" : 3,
            "httpGet" : {
              "path" : "/q/health/live",
              "port" : 8081,
              "scheme" : "HTTP"
            },
            "initialDelaySeconds" : 5,
            "periodSeconds" : 10,
            "successThreshold" : 1,
            "timeoutSeconds" : 10
          },
          "name" : "reconciliation-app",
          "ports" : [ {
            "containerPort" : 8081,
            "name" : "http",
            "protocol" : "TCP"
          } ],
          "readinessProbe" : {
            "failureThreshold" : 3,
            "httpGet" : {
              "path" : "/q/health/ready",
              "port" : 8081,
              "scheme" : "HTTP"
            },
            "initialDelaySeconds" : 5,
            "periodSeconds" : 10,
            "successThreshold" : 1,
            "timeoutSeconds" : 10
          },
          "startupProbe" : {
            "failureThreshold" : 3,
            "httpGet" : {
              "path" : "/q/health/started",
              "port" : 8081,
              "scheme" : "HTTP"
            },
            "initialDelaySeconds" : 5,
            "periodSeconds" : 10,
            "successThreshold" : 1,
            "timeoutSeconds" : 10
          }
        } ],
        "initContainers" : [ {
          "args" : [ "job", "reconciliation-app-flyway-init" ],
          "image" : "groundnuty/k8s-wait-for:no-root-v1.7",
          "imagePullPolicy" : "Always",
          "name" : "wait-for-flyway"
        } ],
        "serviceAccountName" : "reconciliation-app"
      }
    }
  }
},{
  "apiVersion" : "batch/v1",
  "kind" : "Job",
  "metadata" : {
    "name" : "reconciliation-app-flyway-init"
  },
  "spec" : {
    "completionMode" : "NonIndexed",
    "template" : {
      "metadata" : { },
      "spec" : {
        "containers" : [ {
          "env" : [ {
            "name" : "QUARKUS_FLYWAY_ACTIVE",
            "value" : "true"
          }, {
            "name" : "QUARKUS_INIT_AND_EXIT",
            "value" : "true"
          } ],
          "image" : "docker.io/op/reconciliation-app:1.0.0-SNAPSHOT",
          "name" : "reconciliation-app-flyway-init"
        } ],
        "restartPolicy" : "OnFailure",
        "serviceAccountName" : "reconciliation-app"
      }
    }
  }
}]