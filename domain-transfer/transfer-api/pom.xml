<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.acme.platform</groupId>
        <artifactId>domain-transfer</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>transfer-api</artifactId>
    <name>transfer-api</name>
    <description>
        Transfer 業務域之 API 合約層。
        包含:
          - JAX-RS Resource (A16220 / A16229 mock,本機整合測試用)
          - DTO (Request / Response)
          - OpenAPI 規格 (供 MyOpenApiService 在 workflow 內動態呼叫)
        任何 transfer-* workflow 模組都應依賴本模組的合約。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.acme.platform</groupId>
            <artifactId>platform-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-resteasy</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-resteasy-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
    </dependencies>
</project>
